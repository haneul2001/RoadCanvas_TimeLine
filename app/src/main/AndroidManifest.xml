<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 권한은 실제로 쓰는 Pleos API에 필요한 것만 선언한다. -->
    <!-- 기어(주차 판정) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 경로·도착 정보 읽기 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 경로 요청·경유지 등록 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 음성 안내 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 차량 위치(사용자가 여행 기록을 시작할 때 허용을 받는다) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 음성으로 여행 계획 말하기(Voice Planner) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 내비가 앞에 있어도 기록을 이어 가기 위한 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".RoadCanvasApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 주행 UX 제한 확인(차량에 있으면 사용) -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 주행 중에는 음성만 쓰고, 화면 조작은 정차(P)에서만 연다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".trip.TripService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="사용자가 시작한 여행 기록 중 차량 위치를 받아 방문한 지역을 기기 안에 기록함" />
        </service>
    </application>
</manifest>
